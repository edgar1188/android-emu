{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emulador de Android",
  "version": "8.4.0",
  "identifier": "android-emu.app.canaima",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emulador de Android",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "publisher": "Canaima",
    "category": "Utility",
    "shortDescription": "Aplicación nativa para Canaima GNU/Linux",
    "longDescription": "Aplicación de escritorio nativa desarrollada con la plantilla oficial Canaima, Tauri v2 y Vue 3.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emulador Android Canaima",
  "version": "9.0.0+can",
  "identifier": "emulador-android.app.canaima",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emulador de Android Canaima",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "publisher": "Canaima",
    "category": "Utility",
    "shortDescription": "Emulador Android para Canaima GNU/Linux",
    "longDescription": "Emulador de Android para Canaima GNU/Linux",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "adb",
          "curl",
          "qemu-system",
          "qemu-system-x86",
          "qemu-utils",
          "libvirt-clients",
          "libvirt-daemon-system"
        ],
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}